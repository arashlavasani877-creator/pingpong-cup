rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // CRITICAL: Change the UID below to the owner's Authentication UID before Publish.
  function ownerUid() { return 'RDqoIEpOJ1OaAtCGmHO5mulgqQ93'; }
  function signedIn() { return request.auth != null; }
  function isOwner() { return signedIn() && request.auth.uid == ownerUid(); }
  function isManager() {
   return signedIn() && (isOwner() || exists(/databases/$(database)/documents/managers/$(request.auth.uid)));
  }
  function validState(st) {
   return st == null || (
    st is map &&
    st.keys().hasAll(['version','title','players','slots','results','history']) &&
    st.keys().hasOnly(['version','title','players','slots','results','history']) &&
    st.version == 2 && st.title is string && st.title.size() <= 80 &&
    st.players is list && st.players.size() >= 2 && st.players.size() <= 64 &&
    st.slots is list && st.slots.size() <= 64 &&
    st.results is map && st.history is list && st.history.size() <= 127
   );
  }
  function validTournament() {
   return request.resource.data.keys().hasOnly(['state','revision','createdAt','updatedAt']) &&
    request.resource.data.keys().hasAll(['state','revision','createdAt','updatedAt']) &&
    validState(request.resource.data.state) &&
    request.resource.data.revision is int && request.resource.data.revision > 0 &&
    request.resource.data.updatedAt == request.time;
  }
  match /tournaments/{roomId} {
   // Anyone opening the app can browse and view tournament results as a spectator.
   // Never put private personal data in a tournament document.
   allow get, list: if true;
   allow create: if isManager() && validTournament() &&
    request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
   allow update: if isManager() && validTournament() &&
    request.resource.data.revision == resource.data.revision + 1 &&
    request.resource.data.createdAt == resource.data.createdAt;
   // Managers may delete any tournament, but never manager accounts through this path.
   allow delete: if isManager();
  }
  match /managers/{uid} {
   // Owner has permanent privilege via UID, NOT a removable manager document.
   allow get: if isManager() || (signedIn() && request.auth.uid == uid);
   allow list: if isManager();
   allow create: if isManager() && uid != ownerUid() &&
    exists(/databases/$(database)/documents/managerRequests/$(uid)) &&
    request.resource.data.keys().hasOnly(['email','grantedBy','createdAt']) &&
    request.resource.data.keys().hasAll(['email','grantedBy','createdAt']) &&
    request.resource.data.email is string &&
    request.resource.data.email == get(/databases/$(database)/documents/managerRequests/$(uid)).data.email &&
    request.resource.data.grantedBy == request.auth.uid &&
    request.resource.data.createdAt == request.time;
   allow update: if false;
   allow delete: if isManager() && uid != ownerUid();
  }
  match /managerRequests/{uid} {
   allow get: if isManager() || (signedIn() && request.auth.uid == uid);
   allow list: if isManager();
   allow create: if signedIn() && request.auth.uid == uid &&
    request.resource.data.keys().hasOnly(['email','createdAt']) &&
    request.resource.data.keys().hasAll(['email','createdAt']) &&
    request.resource.data.email is string &&
    request.resource.data.email.size() <= 255 &&
    request.resource.data.email == request.auth.token.email &&
    request.resource.data.createdAt == request.time;
   allow update: if false;
   allow delete: if isManager() || (signedIn() && request.auth.uid == uid);
  }
  match /{document=**} { allow read, write: if false; }
 }
}
